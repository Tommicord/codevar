# syntax=docker/dockerfile:1

# Android executables, built with cargo-ndk against the official Android
# NDK. The API level and ABIs mirror `Cargo-ndk.toml` at the repository
# root (API 29; arm64-v8a, armeabi-v7a, x86_64). Produces one `codevar`
# and one `codevar-oclc` executable per ABI.
#
#   docker build -f docker/Dockerfile.android \
#       --target artifacts --output type=local,dest=dist/android .
#
# `docker/build.sh android` runs this build.

ARG RUST_VERSION=1.93
FROM rust:${RUST_VERSION}-bookworm AS builder

ARG NDK_VERSION=r27c
ENV ANDROID_NDK_ROOT=/opt/ndk/android-ndk-${NDK_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
 && rm -rf /var/lib/apt/lists/* \
 # The official NDK archive is a zip; unzip because busybox cannot extract it.
 && curl -fsSL "https://dl.google.com/android/android-ndk-${NDK_VERSION}-linux.zip" \
      -o /tmp/ndk.zip \
 && mkdir -p /opt/ndk \
 && unzip -q /tmp/ndk.zip -d /opt/ndk \
 && rm /tmp/ndk.zip

RUN rustup target add \
    aarch64-linux-android \
    armv7-linux-androideabi \
    x86_64-linux-android \
    i686-linux-android

# Version matches the `cargo-ndk` entry in the workspace dependencies.
RUN cargo install cargo-ndk --version 4.1.2 --locked

WORKDIR /build
COPY . .

# Build every ABI (cargo-ndk picks the per-triple toolchain out of the NDK;
# `-p 29` is the minimum API level, as in Cargo-ndk.toml), then stage the
# per-ABI executables under /out/<triple>/.
RUN --mount=type=cache,id=cargo-registry-android,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-android,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-android,target=/build/target \
    set -eu; \
    for abi in arm64-v8a armeabi-v7a x86_64; do \
        cargo ndk -t "${abi}" -p 29 build --locked --release \
            -p codevar-launcher -p codevar-oclc; \
    done; \
    mkdir -p /out; \
    for triple in aarch64-linux-android armv7-linux-androideabi x86_64-linux-android; do \
        mkdir -p "/out/${triple}"; \
        cp "target/${triple}/release/codevar" "/out/${triple}/codevar"; \
        cp "target/${triple}/release/codevar-oclc" "/out/${triple}/codevar-oclc"; \
    done

FROM scratch AS artifacts
COPY --from=builder /out/ /
