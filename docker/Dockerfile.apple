# syntax=docker/dockerfile:1

# macOS executables, cross-compiled from Linux with cargo-zigbuild: zig
# serves as the C compiler and the Mach-O linker, so no Xcode or macOS SDK
# is required. Produces `codevar` and `codevar-oclc` for
# `x86_64-apple-darwin` and `aarch64-apple-darwin`.
#
#   docker build -f docker/Dockerfile.apple \
#       --build-arg APPLE_TARGET=aarch64-apple-darwin \
#       --target artifacts --output type=local,dest=dist/macos-arm64 .
#
# iOS is intentionally absent here: Apple's license and toolchain require
# building on a macOS host — `docker/build.sh ios` does that.
# `docker/build.sh macos` runs the whole matrix.

ARG RUST_VERSION=1.93
FROM rust:${RUST_VERSION}-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    curl \
    xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Zig, matched to the architecture the container itself runs on (BuildKit
# sets TARGETARCH; plain builds fall back to x86_64).
ARG TARGETARCH
ARG ZIG_VERSION=0.14.0
RUN set -eu; \
    case "${TARGETARCH}" in \
        arm64) zig_arch=aarch64 ;; \
        *) zig_arch=x86_64 ;; \
    esac; \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${zig_arch}-linux-${ZIG_VERSION}.tar.xz" \
        -o /tmp/zig.tar.xz; \
    mkdir -p /opt/zig; \
    tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    rm /tmp/zig.tar.xz
ENV PATH="/opt/zig:${PATH}"

RUN cargo install cargo-zigbuild --locked

ARG APPLE_TARGET=aarch64-apple-darwin
ENV APPLE_TARGET=${APPLE_TARGET}
RUN rustup target add "${APPLE_TARGET}"

WORKDIR /build
COPY . .

RUN --mount=type=cache,id=cargo-registry-apple,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-apple,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-apple,target=/build/target \
    cargo zigbuild --locked --release --target "${APPLE_TARGET}" \
        -p codevar-launcher -p codevar-oclc \
 && mkdir -p /out \
 && cp "target/${APPLE_TARGET}/release/codevar" /out/codevar \
 && cp "target/${APPLE_TARGET}/release/codevar-oclc" /out/codevar-oclc

FROM scratch AS artifacts
COPY --from=builder /out/ /
