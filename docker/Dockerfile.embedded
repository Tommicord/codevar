# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Bare-metal (Cortex-M, RISC-V) and wasm builds. These targets have no C
# toolchain: `rust-lld`, bundled with rustc, does the linking and the repo's
# `.cargo/config.toml` supplies the board linker scripts, so the plain rust
# image suffices.
#
#   docker build -f docker/Dockerfile.embedded \
#       --build-arg EMBEDDED_TARGET=thumbv7em-none-eabi \
#       --target artifacts --output type=local,dest=dist/embedded-thumbv7em .
#
# `docker/build.sh embedded|wasm` runs the pinned matrix.
# ---------------------------------------------------------------------------

ARG RUST_VERSION=1.93
FROM rust:${RUST_VERSION}-bookworm AS builder

ARG EMBEDDED_TARGET=thumbv7m-none-eabi
ENV EMBEDDED_TARGET=${EMBEDDED_TARGET}
RUN rustup target add "${EMBEDDED_TARGET}"

WORKDIR /build
COPY . .

# `codevar-oclc` is the crate with a `no_std` bare-metal/wasm entry point
# (vector table, reset stub, linker scripts); the windowing crates need
# hosted OSes and are not built for these targets.
RUN --mount=type=cache,id=cargo-registry-embedded,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-embedded,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-embedded,target=/build/target \
    cargo build --locked --release --target "${EMBEDDED_TARGET}" -p codevar-oclc \
 && mkdir -p "/out/${EMBEDDED_TARGET}" \
 && cp "target/${EMBEDDED_TARGET}/release/codevar-oclc" "/out/${EMBEDDED_TARGET}/codevar-oclc"

FROM scratch AS artifacts
COPY --from=builder /out/ /
