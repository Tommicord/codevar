# syntax=docker/dockerfile:1

# Fully static Linux build (musl).
#
# The result links statically against the musl libc bundled with rustc's
# std, so it runs on any Linux kernel and distribution — Alpine and other
# musl systems, scratch images, read-only root filesystems, and minimal
# embedded-Linux environments included. Build one platform per invocation:
#
#   docker build --platform linux/arm64 -f docker/Dockerfile.musl \
#       --target artifacts --output type=local,dest=dist/musl-arm64 .
#
# `docker/build.sh musl` runs the whole matrix.

ARG RUST_VERSION=1.93
FROM rust:${RUST_VERSION}-alpine AS builder

# build-base (gcc, musl-dev, make) provides the linker wrapper; no other
# tooling is required because the dependency graph contains no C code.
RUN apk add --no-cache build-base

WORKDIR /build
COPY . .

# No `--target` flag: the Alpine host triple *is* a musl triple, so rustc
# picks the static musl libc that ships with its own std, whatever
# architecture the container is emulating or running natively.
RUN --mount=type=cache,id=cargo-registry-musl,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-musl,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-musl,target=/build/target \
    cargo build --locked --release -p codevar-launcher -p codevar-oclc \
 && mkdir -p /out \
 && cp target/release/codevar /out/codevar \
 && cp target/release/codevar-oclc /out/codevar-oclc

FROM scratch AS artifacts
COPY --from=builder /out/ /
